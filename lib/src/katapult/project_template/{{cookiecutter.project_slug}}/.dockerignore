# Git metadata
.git/

# Environment and secret material
.env
.env.*
*.pem
*.key
.ssh/

# Python-generated files
__pycache__/
*.py[cod]

# Virtual environments (any depth; venvs are baked in-image, never copied from host)
**/.venv/

# Build artifacts
dist/
wheels/
*.egg-info/
*.zip

# Development notes
notes/

# IDE files
.vscode/
.idea/

# Quarto cache
.quarto/

# Jupyter artifacts
**/.ipynb_checkpoints/
**/.Trash*/
**/sandbox/
