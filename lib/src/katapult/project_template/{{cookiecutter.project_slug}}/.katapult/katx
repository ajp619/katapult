#!/bin/bash

# get abs path to project location
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
PROJECT_DIR=$(dirname "$SCRIPT_DIR")

# from BuildConfig
source $PROJECT_DIR/build/BuildConfig

# defaults (skip blank lines and '#' comments so BuildConfig can be documented)
BUILD_ARGS=$(awk 'NF && $0 !~ /^[[:space:]]*#/ {print "--build-arg " $0}' $PROJECT_DIR/build/BuildConfig)

# If UID_ and GID_ are not in BuildConfig, detect and add them
if ! grep -q "^UID_=" $PROJECT_DIR/build/BuildConfig 2>/dev/null; then
    BUILD_ARGS="$BUILD_ARGS --build-arg UID_=$(id -u)"
fi
if ! grep -q "^GID_=" $PROJECT_DIR/build/BuildConfig 2>/dev/null; then
    BUILD_ARGS="$BUILD_ARGS --build-arg GID_=$(id -g)"
fi
IMAGE_NAME="$IMAGE_ROOT/$PROJECT_NAME"
CONTAINER_NAME="$IMAGE_ROOT-$PROJECT_NAME"
USER=""
HOST="localhost"

source $PROJECT_DIR/.katapult/HOSTVARS

# Public-access state (managed by `katx pub` / `katx private`, persisted in HOSTVARS).
# When PUBLIC=true, compose layers build/docker-compose.pub.yml on top of the base
# file so this project is served on Traefik's `public` entrypoint (:8081) and
# advertised to the pub_index dashboard. Default is private. PUBLIC is a per-host
# setting, so it lives in HOSTVARS (not committed), like HOST and USER.
PUBLIC="${PUBLIC:-false}"
PUB_COMPOSE_FILE="$PROJECT_DIR/build/docker-compose.pub.yml"
COMPOSE_FILES="-f $PROJECT_DIR/build/docker-compose.yml"
if [ "$PUBLIC" = "true" ]; then
  if [ -f "$PUB_COMPOSE_FILE" ]; then
    COMPOSE_FILES="$COMPOSE_FILES -f $PUB_COMPOSE_FILE"
  else
    echo "warning: PUBLIC=true but build/docker-compose.pub.yml is missing; starting private." >&2
    PUBLIC="false"
  fi
fi

# Persist PUBLIC=<true|false> into HOSTVARS (rewrites any existing line).
function set_public_hostvar {
  local val="$1"
  local hv="$PROJECT_DIR/.katapult/HOSTVARS"
  local tmp
  tmp=$(grep -v "^PUBLIC=" "$hv" 2>/dev/null)
  printf '%s\n' "$tmp" > "$hv"
  echo "PUBLIC=$val" >> "$hv"
}

# create a place holder for positional args
POS_ARGS=""

function clear_last_line {
  tput cuu 1
  tput ed
  tput sc
}

# --------------------------------------------------------------------------------------
# Extract flags
#
while (( "$#" )); do #while there are still args to parse
  # look at the first one
  case "$1" in
    --build-args|-b)
      # check that there is an argument ($2) and that it does not start with '-'
      if [ -n "$2" ] && [ ${2:0:1} != "-" ]; then
        BUILD_ARGS="$BUILD_ARGS --build-arg $2"
        # drop the first two arguments
        shift 2
      else
        # output an error msg, (> &2 redirects to stderr)
        echo "Error: Argument for $1 is missing" >&2
        exit 1
      fi
      ;;
    --host|-h)
      # check that there is an argument ($2) and that it does not start with '-'
      if [ -n "$2" ] && [ ${2:0:1} != "-" ]; then
        HOST="$2"
        echo "setting host to $2"
        HOSTVARS_TMP=$(grep -v "^HOST=" "$PROJECT_DIR/.katapult/HOSTVARS")
        printf '%s\n' "$HOSTVARS_TMP" > "$PROJECT_DIR/.katapult/HOSTVARS"
        echo "HOST=$2" >> "$PROJECT_DIR/.katapult/HOSTVARS"
        shift 2
      else
        # output an error msg, (> &2 redirects to stderr)
        echo "Error: Argument for $1 is missing" >&2
        exit 1
      fi
      ;;
    --help)
      format='  %-20s %-s\n'
      printf "options:\n"
      printf "$format" "--build-args|-b" "add additional arguments to docker build."
      printf "$format" "--help" "prints this message."
      printf "$format" "--host|-h" "sets current hostname. Remembers setting."
      printf "$format" "--user|-u" "set the user option to use with docker exec. Defaults to ''. Remembers setting."
      printf "\n"
      printf "positional commands:\n"
      printf "$format" "build" "runs docker build."
      printf "$format" "connect" "runs docker exec to start a shell in the project's container."
      printf "$format" "debug" "Placeholder for custom docker run command intended for debugging."
      printf "$format" "down" "\`docker compose down\`."
      printf "$format" "jlab" "lists the address (including token) of the currently running jupyter server."
      printf "$format" "private" "Unpublish: stop serving on the public entrypoint and recreate the container."
      printf "$format" "ps" "Lists containers associated with this project."
      printf "$format" "pub" "Publish: serve this project on the public entrypoint (:8081) + dashboard. Remembers setting."
      printf "$format" "render" "Run 'quarto render' to create static site files."
      printf "$format" "restart|rebuild" "Shortcut for: katx down, katx build, katx up."
      printf "$format" "rm" "\`docker rm ...\`."
      printf "$format" "rmf" "\`docker rm -f ...\`."
      printf "$format" "run" "Shortcut for: katx build, katx up, katx render, katx status."
      printf "$format" "services" "list | enable <name> | disable <name>: toggle supervisor programs (conf.d)."
      printf "$format" "status" "supervisorctl status."
      printf "$format" "stop" "manual docker stop command. Generally better to use 'down'"
      printf "$format" "update_context" "Sync shared context files from ~/.katapult/template/ (removes stale, copies fresh)."
      printf "$format" "up" "\`docker compose up -d\`."
      shift
      ;;
    --user|-u)
      # check that there is an argument ($2) and that it does not start with '-'
      if [ -n "$2" ] && [ ${2:0:1} != "-" ]; then
        # set the user option to use with docker exec. Defaults to ""
        USER="-u $2"
        echo "setting user to $2"
        HOSTVARS_TMP=$(grep -v "^USER=" "$PROJECT_DIR/.katapult/HOSTVARS")
        printf '%s\n' "$HOSTVARS_TMP" > "$PROJECT_DIR/.katapult/HOSTVARS"
        echo "USER='-u $2'" >> "$PROJECT_DIR/.katapult/HOSTVARS"
        # drop the first two arguments
        shift 2
      else
        # output an error msg, (> &2 redirects to stderr)
        echo "Error: Argument for $1 is missing" >&2
        exit 1
      fi
      ;;
    -*) # unsupported flags
      # started with -*|--*=) but the second part seems unnecessary
      # output an error msg, (> &2 redirects to stderr)
      echo "Error: Unsupported flag $1" >&2
      exit 1
      ;;
    *) # preserve positional arguments
      POS_ARGS="$POS_ARGS $1"
      shift
      ;;
  esac
done
# set positional arguments in their proper place -> $1 $2 ...
eval set -- "$POS_ARGS"

#echo $POS_ARGS

# --------------------------------------------------------------------------------------
# Positional args
#

while (( "$#" )); do
  case "$1" in
    build)
      echo "building image $IMAGE_NAME"
      set -x
      docker build \
        --tag $IMAGE_NAME \
        -f $PROJECT_DIR/build/Dockerfile \
        $BUILD_ARGS \
        $PROJECT_DIR
      set +x
      clear_last_line
      shift
      ;;
    connect)
      clear
      echo "connecting to $CONTAINER_NAME"
      set -x
      docker exec -it $USER $CONTAINER_NAME bash
      set +x
      clear_last_line
      clear
      shift
      ;;
    debug)
      echo "creating container: $CONTAINER_NAME from image: $IMAGE_NAME"
      set -x
      docker run \
        --name $CONTAINER_NAME \
        -d \
        -it \
        --rm \
        --volume $PROJECT_DIR:/content/ \
        --volume /content/api/.venv \
        --volume /content/app/.venv \
        --volume /content/nbk/.venv \
        --network katapult \
        $IMAGE_NAME
      set +x
      clear_last_line
      shift
      ;;
    down)
      set -x
      docker compose --env-file $PROJECT_DIR/build/BuildConfig $COMPOSE_FILES down
      set +x
      clear_last_line
      shift
      ;;
    home)
      echo "Running at: http://$HOST/$PROJECT_NAME/"
      shift
      ;;
    jlab)
      CMD='cd /content/nbk && uv run jupyter server list'
      set -x
      docker exec \
        -it \
        $CONTAINER_NAME \
        bash -c "$CMD" \
          | sed "s/\:8888//" \
          | sed "s/localhost/$HOST/" 
      set +x
      clear_last_line
      shift
      ;;
    private)
      echo "unpublishing $PROJECT_NAME (private)"
      set_public_hostvar "false"
      PUBLIC="false"
      COMPOSE_FILES="-f $PROJECT_DIR/build/docker-compose.yml"
      shift
      # Recreate without the pub override so the public router is removed.
      set -- "up" $@
      ;;
    ps)
      docker ps -a | awk "FNR==1 || /$PROJECT_NAME/"
      shift
      ;;
    pub)
      if [ ! -f "$PUB_COMPOSE_FILE" ]; then
        echo "Error: build/docker-compose.pub.yml not found. This project predates the" >&2
        echo "       public-access feature; run the retrofit script to add it." >&2
        exit 1
      fi
      echo "publishing $PROJECT_NAME on the public entrypoint (:8081)"
      set_public_hostvar "true"
      PUBLIC="true"
      COMPOSE_FILES="-f $PROJECT_DIR/build/docker-compose.yml -f $PUB_COMPOSE_FILE"
      shift
      # Recreate with the pub override so the public router + metadata are applied.
      set -- "up" $@
      ;;
    render)
      CMD="quarto render && uvx --refresh --with lib/. pdoc -o docs/lib $PROJECT_NAME"
      set -x
      docker exec \
        -it \
        $CONTAINER_NAME \
        bash -c "$CMD"
      set +x
      clear_last_line
      shift
      ;;
    restart|rebuild)
      echo "restarting $CONTAINER_NAME"
      shift
      set -- "down" "build" "up" $@
      ;;
    rm)
      echo "removing $CONTAINER_NAME"
      set -x
      docker rm $CONTAINER_NAME
      set +x
      clear_last_line
      shift
      ;;
    rmf)
      #echo "force removing $CONTAINER_NAME"
      set -x
      docker rm -f $CONTAINER_NAME
      set +x
      clear_last_line
      shift
      ;;
    run)
      echo "starting $CONTAINER_NAME"
      shift
      set -- "build" "up" "render" "status" "home" $@
      ;;
    services)
      # Manage which supervisor programs run by toggling conf.d/*.conf <-> *.conf_.
      # conf.d file-state is the source of truth for both runtime and the build-time
      # venv bake (see build/Dockerfile). Names are validated against the confs present.
      confd="$PROJECT_DIR/build/conf/supervisor/conf.d"
      sub="$2"
      svc="$3"
      # Collect available service names from both enabled (.conf) and disabled (.conf_) files.
      avail=""
      for f in "$confd"/*.conf "$confd"/*.conf_; do
        [ -e "$f" ] || continue
        b=$(basename "$f"); b=${b%.conf_}; b=${b%.conf}
        case " $avail " in *" $b "*) : ;; *) avail="$avail $b" ;; esac
      done
      avail=$(printf '%s\n' $avail | sort | tr '\n' ' ')
      case "$sub" in
        ""|list)
          printf '%-20s %s\n' "SERVICE" "STATE"
          for s in $avail; do
            if [ -f "$confd/$s.conf" ]; then
              printf '%-20s %s\n' "$s" "enabled"
            else
              printf '%-20s %s\n' "$s" "disabled"
            fi
          done
          if [ -z "$sub" ]; then shift 1; else shift 2; fi
          ;;
        enable)
          if [ -z "$svc" ]; then echo "Error: 'services enable' requires a service name. Available:$avail" >&2; exit 1; fi
          case " $avail " in *" $svc "*) : ;; *) echo "Error: unknown service '$svc'. Available:$avail" >&2; exit 1 ;; esac
          if [ -f "$confd/$svc.conf" ]; then
            echo "$svc already enabled"
          else
            mv "$confd/$svc.conf_" "$confd/$svc.conf"
            echo "enabled $svc"
          fi
          shift 3
          ;;
        disable)
          if [ -z "$svc" ]; then echo "Error: 'services disable' requires a service name. Available:$avail" >&2; exit 1; fi
          case " $avail " in *" $svc "*) : ;; *) echo "Error: unknown service '$svc'. Available:$avail" >&2; exit 1 ;; esac
          if [ -f "$confd/$svc.conf_" ]; then
            echo "$svc already disabled"
          else
            mv "$confd/$svc.conf" "$confd/$svc.conf_"
            echo "disabled $svc"
          fi
          shift 3
          ;;
        *)
          echo "Error: unknown 'services' subcommand '$sub'. Use: list | enable <name> | disable <name>" >&2
          exit 1
          ;;
      esac
      ;;
    status)
      CMD='supervisorctl status'
      set -x
      docker exec \
        -it \
        $CONTAINER_NAME \
        bash -c "$CMD"
      set +x
      clear_last_line
      shift
      ;;
    stop)
      set -x
      docker stop $CONTAINER_NAME
      set +x
      clear_last_line
      shift
      ;;
    update_context)
      KATAPULT_HOME="$HOME/.katapult"
      TEMPLATE_DIR="$KATAPULT_HOME/template"
      MANIFEST="$PROJECT_DIR/.katapult/.context_manifest"

      if [ ! -d "$TEMPLATE_DIR" ]; then
        echo "Error: $TEMPLATE_DIR does not exist." >&2
        exit 1
      fi

      if [ -f "$MANIFEST" ]; then
        while IFS= read -r file; do
          case "$file" in
            ""|\#*)
              continue
              ;;
            /*|../*|*/../*|..|*/..)
              echo "  skipped unsafe manifest path: $file" >&2
              continue
              ;;
          esac
          target="$PROJECT_DIR/$file"
          if [ -f "$target" ]; then
            rm "$target"
            echo "  removed: $file"
          fi
        done < "$MANIFEST"
      fi

      mkdir -p "$(dirname "$MANIFEST")"
      > "$MANIFEST"
      while IFS= read -r -d '' file; do
        rel="${file#./}"
        mkdir -p "$(dirname "$PROJECT_DIR/$rel")"
        cp -p "$TEMPLATE_DIR/$rel" "$PROJECT_DIR/$rel"
        echo "$rel" >> "$MANIFEST"
        echo "  synced: $rel"
      done < <(cd "$TEMPLATE_DIR" && find . -type f -print0 | sort -z)

      echo "Context updated from $TEMPLATE_DIR"
      shift
      ;;
    up)
      set -x
      docker compose --env-file $PROJECT_DIR/build/BuildConfig $COMPOSE_FILES up -d
      set +x
      clear_last_line
      shift
      set -- "ps" $@
      ;;
    *)
      shift
      ;;
  esac
done

