# Opt-in delegate backend for the MCP server's `delegate` tool.
#
# Public default is `none` (the neutral server exposes only vendor-free tools).
# The ~/.katapult/template/ overlay flips this to e.g. `cursor` and drops
# build/.agent_credentials. Resolving the backend from this small file (rather
# than build/BuildConfig) keeps the overlay surgical -- no whole-file BuildConfig
# clone, no drift.
AGENT_BACKEND=none
