IMAGE_ROOT=katapult
PROJECT_NAME={{cookiecutter.project_slug}}

USERNAME=katapult
USERGROUP=katapult

UBUNTU_RELEASE=24.04

PYTHON_VERSION={{cookiecutter.python_version}}
NODE_VERSION=20.9.0
QUARTO_VERSION=1.7.27

# MCP server (per-project, IDE-neutral). Set to `off` to omit the dev-only MCP
# service from the image entirely (keeps test/prod agent-free). The opt-in
# delegate backend is configured separately in build/agent.env (default none),
# so the ~/.katapult overlay can activate it without cloning this file.
MCP_SERVER=on

# Optional: restrict which supervisor programs run AND which venvs bake, as a
# comma-separated allowlist of program names (no spaces; the names shown by
# `katx services`, e.g. api, webapp, jupyter, nginx). Normally leave unset and
# manage services with `katx services`. Use for thin per-service images:
# `katx build -b SERVICES=api` or `-b SERVICES=api,jupyter`.
# SERVICES=api,jupyter
#
# NOTE: this file is sourced by katx as a shell script (and each line becomes a
# docker --build-arg), so every value must be a single shell-safe token -- no
# spaces. Dashboard display text (title/description) with spaces goes in
# build/docker-compose.pub.yml label values instead, not here.
